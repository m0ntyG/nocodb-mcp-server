{
  "name": "nocodb-mcp-server",
  "version": "1.0.24",
  "description": "Model Context Protocol server for nocodb",
  "scripts": {
    "build": "esbuild src/start.ts --bundle --platform=node --target=node18 --format=esm --outfile=dist/start.js --external:@modelcontextprotocol/sdk --external:axios --external:zod"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "nocodb-mcp-server": "dist/start.js"
  },
  "homepage": "https://github.com/edwinbernadus/nocodb-mcp-server.git",
  "keywords": [
    "nocodb",
    "mcp",
    "model context protocol",
    "nocodb mcp"
  ],
  "author": "edwinbernadus",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/edwinbernadus/nocodb-mcp-server.git"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "esbuild": "^0.27.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "axios": "^1.13.4",
    "zod": "^3.24.2"
  }
}
